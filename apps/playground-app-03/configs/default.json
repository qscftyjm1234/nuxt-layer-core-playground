{
  "$schema": "./schema.json",
  "//": "Softleader Nuxt Core 專案常數設定檔 (Blueprint)",
  "branding": {
    "name": "apps/playground-app-03",
    "shortName": "PLAYGROUND-APP-03",
    "logo": "/images/logo.png",
    "icon": "/favicon.ico",
    "copyright": "© 2026 Softleader Technical Team. All rights reserved."
  },
  "meta": {
    "title": "apps/playground-app-03",
    "description": "企業級 Nuxt 3 核心架構",
    "author": "Softleader Team",
    "lang": "zh-TW"
  },
  "layout": {
    "menuStyle": "sidebar",
    "sidebar": {
      "width": 260,
      "title": "管理系統"
    },
    "header": {
      "fixed": true,
      "search": true,
      "searchPlaceholder": "搜尋組件..."
    }
  },
  "theme": {
    "primaryColor": "#2563eb",
    "borderRadius": 12,
    "animation": true,
    "customCss": []
  },
  "network": {
    "apiBaseUrl": "/api/v1",
    "proxy": {
      "/api/v1": {
        "target": "http://dev-api-server:8080",
        "changeOrigin": true,
        "rewrite": "^/api/v1"
      }
    }
  },
  "features": {
    "enableWatermark": false,
    "enableAuth": true,
    "enableLog": true
  },
  "build": {
    "compress": true,
    "optimizeDeps": []
  },
  "modules": {
    "@nuxtjs/i18n": true,
    "@ant-design-vue/nuxt": true
  }
}