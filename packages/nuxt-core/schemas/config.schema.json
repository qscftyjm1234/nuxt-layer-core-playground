{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Softleader Nuxt Core Product Configuration",
  "type": "object",
  "properties": {
    "branding": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "公司名稱" },
        "shortName": { "type": "string", "description": "簡寫或標籤名" },
        "logo": { "type": "string", "description": "主 Logo 路徑" },
        "logoDark": { "type": "string", "description": "暗色版 Logo" },
        "icon": { "type": "string", "description": "網頁 Favicon/手機 Icon" },
        "copyright": { "type": "string", "description": "Footer 版權文字" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "預設網頁標題" },
        "description": { "type": "string", "description": "SEO 描述" },
        "author": { "type": "string", "description": "作者/團隊" },
        "lang": { "type": "string", "description": "語系 (zh-TW, en, etc.)" }
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "menuStyle": { "type": "string", "enum": ["sidebar", "topbar", "hybrid"] },
        "sidebar": {
          "type": "object",
          "properties": {
            "width": { "type": "number", "default": 260 },
            "collapsed": { "type": "boolean", "default": false },
            "title": { "type": "string" },
            "showIcon": { "type": "boolean", "default": true }
          }
        },
        "header": {
          "type": "object",
          "properties": {
            "fixed": { "type": "boolean", "default": true },
            "search": { "type": "boolean", "default": true },
            "searchPlaceholder": { "type": "string" },
            "showUserAction": { "type": "boolean", "default": true }
          }
        },
        "footer": {
          "type": "object",
          "properties": {
            "visible": { "type": "boolean", "default": true },
            "content": { "type": "string" }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string", "format": "color" },
        "successColor": { "type": "string", "format": "color" },
        "warningColor": { "type": "string", "format": "color" },
        "errorColor": { "type": "string", "format": "color" },
        "infoColor": { "type": "string", "format": "color" },
        "borderRadius": { "type": "number", "default": 12 },
        "animation": { "type": "boolean", "default": true },
        "spacingSize": { "type": "string", "enum": ["small", "medium", "large"] },
        "customCss": {
          "type": "array",
          "items": { "type": "string" },
          "description": "允許額外注入的全域 CSS 檔案路徑 (相對於專案根目錄)"
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "apiBaseUrl": { "type": "string" },
        "proxy": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "target": { "type": "string" },
              "changeOrigin": { "type": "boolean", "default": true },
              "rewrite": { "type": "string" }
            },
            "required": ["target"]
          }
        }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "enableWatermark": { "type": "boolean", "default": false },
        "enableAuth": { "type": "boolean", "default": true },
        "enableLog": { "type": "boolean", "default": true }
      }
    },
    "build": {
      "type": "object",
      "description": "建置與性能優化設定",
      "properties": {
        "compress": { "type": "boolean", "default": true, "description": "是否開啟 Nitro 資源壓縮 (.gz, .br)" },
        "analyze": { "type": "boolean", "default": false, "description": "是否開啟建置分析 (Bundle Analyzer)" },
        "optimizeDeps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "強制 Vite 預選構建的依賴套件"
        }
      }
    },
    "modules": {
      "type": "object",
      "description": "模組開關控制 (設為 false 可停用 Layer 內建模組)",
      "additionalProperties": { "type": "boolean" }
    }
  }
}
