{
  "name": "ci-test-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "dependencies": {
    "softleader-nuxt-core": "latest"
  },
  "devDependencies": {
    "nuxt": "^3.15.4",
    "vue": "latest",
    "vue-router": "latest",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "@commitlint/cli": "^19.5.0",
    "commitizen": "^4.3.0",
    "cz-customizable": "^7.0.0",
    "cross-env": "^7.0.3"
  }
}