{
  "name": "softleader-nuxt-core",
  "version": "2.0.0",
  "description": "Nuxt 3 Core Layer - 可重用的基礎架構",
  "type": "module",
  "files": [
    "assets",
    "components",
    "composables",
    "configs",
    "core",
    "i18n",
    "layouts",
    "modules",
    "plugins",
    "router",
    "scripts",
    "styles",
    "utils",
    "stores",
    "types",
    "bin",
    "schemas",
    "nuxt.config.ts",
    "tsconfig.json",
    "eslint.config.mjs",
    "prettier.config.cjs",
    "commitlint.config.cjs",
    "cz.config.cjs",
    "lint-staged.config.js",
    ".eslintrc.cjs",
    ".prettierrc",
    "README.md"
  ],
  "exports": {
    ".": "./nuxt.config.ts",
    "./eslint": "./eslint.config.mjs",
    "./prettier": "./prettier.config.cjs",
    "./commitlint": "./commitlint.config.cjs",
    "./cz": "./cz.config.cjs",
    "./lint-staged": "./lint-staged.config.js",
    "./utils/scanner": "./router/routes-scanner.ts",
    "./core/options/registry": "./core/options/registry.ts",
    "./core/options/types": "./core/options/types.ts",
    "./core/config/*": "./core/config/*"
  },
  "bin": {
    "softleader-nuxt-core": "./bin/init.mjs"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "sync-configs": "node scripts/sync-configs.mjs",
    "release": "node scripts/release.mjs",
    "test:init": "npm pack && node bin/init.mjs init ${1:-tmp-test-project} && rm *.tgz"
  },
  "dependencies": {
    "@nuxt/eslint-config": "^0.5.7",
    "@nuxt/fonts": "0.11.0",
    "@nuxt/icon": "^1.11.0",
    "@nuxt/kit": "^3.15.4",
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@pinia/nuxt": "^0.10.1",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vueuse/core": "^10.11.1",
    "dayjs": "1.11.13",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.2.4",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.28.0",
    "lodash.clonedeep": "4.5.0",
    "pinia": "3.0.1",
    "prettier": "^3.5.3",
    "sass": "^1.85.0",
    "typescript": "^5.7.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.8",
    "vuetify": "^3.11.8"
  },
  "devDependencies": {
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "latest",
    "cross-env": "7.0.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "nuxt": "^3.15.4"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0"
  },
  "keywords": [
    "nuxt3",
    "layer",
    "softleader",
    "configuration-driven",
    "blueprint",
    "design-system"
  ],
  "author": "Softleader",
  "license": "MIT"
}
