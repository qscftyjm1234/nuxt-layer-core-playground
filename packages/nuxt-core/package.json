{
  "name": "softleader-nuxt-core",
  "version": "1.0.9",
  "description": "Nuxt 3 Core Layer - 可重用的基礎架構",
  "type": "module",
  "files": [
    "assets",
    "components",
    "composables",
    "configs",
    "core",
    "i18n",
    "layouts",
    "modules",
    "plugins",
    "router",
    "scripts",
    "styles",
    "utils",
    "stores",
    "types",
    "nuxt.config.ts",
    "tsconfig.json",
    ".eslintrc.cjs",
    ".prettierrc",
    "README.md"
  ],
  "exports": {
    ".": "./nuxt.config.ts",
    "./utils/scanner": "./router/routes-scanner.ts"
  },
  "bin": {
    "softleader-nuxt-core": "./bin/init.mjs"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "@ant-design-vue/nuxt": "^1.0.0",
    "@nuxt/eslint-config": "^0.5.7",
    "@nuxt/fonts": "0.11.0",
    "@nuxt/icon": "^1.11.0",
    "@nuxt/kit": "^3.15.4",
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@pinia/nuxt": "^0.10.1",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vueuse/core": "^10.11.1",
    "ant-design-vue": "^4.2.1",
    "dayjs": "1.11.13",
    "eslint": "^9.22.0",
    "lodash.clonedeep": "4.5.0",
    "pinia": "3.0.1",
    "prettier": "^3.5.3",
    "sass": "^1.85.0",
    "typescript": "^5.7.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^2.2.8",
    "vuetify": "^3.11.8"
  },
  "devDependencies": {
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "latest",
    "cross-env": "7.0.3",
    "nuxt": "^3.15.4"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0"
  },
  "keywords": [
    "nuxt3",
    "layer",
    "design-system"
