{
  "name": "nuxt-layer-core-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Nuxt 3 Core Layer Playground - 可重用的 Nuxt 3 架構",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/setup-env.mjs && git config core.hooksPath packages/nuxt-core/core/templates/husky",
    "dev": "npm run dev:ui-docs",
    "dev:playground": "npm run dev -w playground-app",
    "dev:ui-docs": "npm run dev -w ui-docs",
    "dev:demo": "npm run dev -w demo-app",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "cz",
    "recreate-demo": "node scripts/recreate-demo.mjs"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./node_modules/softleader-nuxt-core/cz.config.cjs"
    }
  },
  "prettier": "softleader-nuxt-core/prettier",
  "commitlint": {
    "extends": [
      "softleader-nuxt-core/commitlint"
    ]
  },
  "lint-staged": {
    "extends": [
      "softleader-nuxt-core/lint-staged"
    ]
  },
  "keywords": [
    "nuxt3",
    "layer",
    "monorepo",
    "design-system"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.1"
  }
}
